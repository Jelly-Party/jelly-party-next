# Optional build-time overrides. The single authoritative defaults live in config/urls.ts.
# Uncomment only the values that differ for a particular deployment.
# VITE_JELLY_WEBSITE_URL=https://website.example
# VITE_JELLY_JOIN_URL=https://invites.example
# VITE_JELLY_WS_URL=wss://relay.example
# VITE_JELLY_REPOSITORY_URL=https://code.example/project
# VITE_JELLY_CHROME_STORE_URL=https://store.example/chrome
# VITE_JELLY_EDGE_STORE_URL=https://store.example/edge
# VITE_JELLY_FIREFOX_STORE_URL=https://store.example/firefox
