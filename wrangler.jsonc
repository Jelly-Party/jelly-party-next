{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jelly-party-relay",
  "main": "packages/jelly-party-server/src/main.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "jelly-party.com/*", "zone_name": "jelly-party.com" },
    { "pattern": "www.jelly-party.com/*", "zone_name": "jelly-party.com" },
  ],
  "assets": {
    "directory": "packages/jelly-party-website/build",
    "not_found_handling": "404-page",
    "run_worker_first": ["/health", "/party/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "PARTY", "class_name": "Party" }],
  },
  "exports": {
    "Party": { "type": "durable-object", "storage": "sqlite" },
  },
}
